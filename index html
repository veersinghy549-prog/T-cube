<!DOCTYPE html>
<html lang="hi"><head><meta charset="utf-8"><title>T Cube Social</title><style>body,html{background:#000}::placeholder{color:#777}</style>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#000000"><meta name="mobile-web-app-capable" content="yes">
<style>
:root{--bg:#000;--card:#121212;--tx:#f2f2f2;--mu:#9a9a9a;--bl:#5cb8ff;--bd:#2a2a2a;color-scheme:dark}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--tx);font-family:system-ui,sans-serif;padding-top:env(safe-area-inset-top);padding-bottom:env(safe-area-inset-bottom)}
header{position:sticky;top:0;background:#000;padding:10px 14px;font-weight:700;font-size:22px;color:#5cb8ff;border-bottom:1px solid var(--bd);z-index:5;letter-spacing:.5px}
.tabs{display:flex;background:#000;border-bottom:1px solid var(--bd);position:sticky;top:46px;z-index:4}.tabs button{flex:1;background:none;color:var(--mu);border-radius:0;padding:10px}.tabs button.a{color:var(--bl);border-bottom:3px solid var(--bl)}
main{max-width:560px;margin:0 auto;padding:10px}.card{background:var(--card);border-radius:10px;padding:12px;margin-bottom:10px;border:1px solid var(--bd)}
textarea,input[type=text],input[type=email],input[type=password]{width:100%;border:1px solid var(--bd);border-radius:10px;padding:10px 12px;margin-top:8px;background:var(--bg);color:var(--tx);font:inherit}textarea{resize:none}
button{border:0;background:var(--bl);color:#000;border-radius:8px;padding:8px 14px;font:inherit;font-weight:600}button.g{background:none;color:var(--mu)}button.on{color:var(--bl)}
.row{display:flex;gap:8px;align-items:center;margin-top:8px}.sp{flex:1}.h{display:flex;gap:10px;align-items:center}.n{font-weight:600}.t{font-size:12px;color:var(--mu)}
.av{width:38px;height:38px;border-radius:50%;background:var(--bl);color:#000;display:flex;align-items:center;justify-content:center;font-weight:700;flex:none;object-fit:cover}.big{width:96px;height:96px;font-size:36px;margin:0 auto}
.p{margin:10px 0;white-space:pre-wrap;word-break:break-word}img.m{width:100%;border-radius:8px;max-height:480px;object-fit:contain;background:#000}
.bar{display:flex;border-top:1px solid var(--bd);margin-top:8px;padding-top:4px}.bar button{flex:1}.c{font-size:14px;margin:6px 0;background:var(--bg);padding:6px 10px;border-radius:14px}.pv{max-width:100%;max-height:200px;border-radius:8px;margin-top:8px}
</style></head><body>
<header>T Cube Social</header>
<div id="login" style="display:none"><main><div class="card"><b id="lt">рд▓реЙрдЧрд┐рди рдХрд░реЗрдВ</b>
<input type="text" id="nm" placeholder="рдЖрдкрдХрд╛ рдирд╛рдо" style="display:none"><input type="email" id="em" placeholder="рдИрдореЗрд▓"><input type="password" id="pw" placeholder="рдкрд╛рд╕рд╡рд░реНрдб (рдХрдо рд╕реЗ рдХрдо 6 рдЕрдХреНрд╖рд░)">
<div class="row"><button onclick="go()" id="gb">рд▓реЙрдЧрд┐рди</button><button class="g" onclick="sw()" id="sb">рдирдпрд╛ рдЕрдХрд╛рдЙрдВрдЯ рдмрдирд╛рдПрдБ</button></div><div class="t" id="le"></div></div></main></div>
<div id="app" style="display:none">
<div class="tabs"><button id="t0" class="a" onclick="tab(0)">ЁЯПа рд╣реЛрдо</button><button id="t1" onclick="tab(1)">ЁЯСе рджреЛрд╕реНрдд</button><button id="t2" onclick="tab(2)">ЁЯСд рдкреНрд░реЛрдлрд╝рд╛рдЗрд▓</button></div>
<main>
<div id="home"><div class="card"><textarea id="tx" rows="3" placeholder="рдЖрдкрдХреЗ рдорди рдореЗрдВ рдХреНрдпрд╛ рд╣реИ?"></textarea><div id="pvw"></div>
<div class="row"><button class="g" onclick="f.click()">ЁЯУ╖ рдлреЛрдЯреЛ</button><span class="sp"></span><button id="pb" onclick="post()">рдкреЛрд╕реНрдЯ рдХрд░реЗрдВ</button></div><input type="file" id="f" accept="image/*" hidden><div class="t" id="msg"></div></div>
<div class="row" style="margin:0 0 8px"><button class="g on" id="f0" onclick="flt(0)">рд╕рдм</button><button class="g" id="f1" onclick="flt(1)">рд╕рд┐рд░реНрдл рджреЛрд╕реНрдд</button></div><div id="feed"></div></div>
<div id="fr" style="display:none"></div><div id="pf" style="display:none"></div>
</main></div>
<script type="module">
import {initializeApp} from "https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js";
import {getAuth,onAuthStateChanged,createUserWithEmailAndPassword,signInWithEmailAndPassword,signOut} from "https://www.gstatic.com/firebasejs/10.14.1/firebase-auth.js";
import {getFirestore,collection,doc,setDoc,updateDoc,deleteDoc,addDoc,onSnapshot,query,orderBy,limit,arrayUnion,arrayRemove} from "https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore.js";
const app=initializeApp({apiKey:"AIzaSyAtd_0ExQVtKj1LfCEQyZnlwn7GfJz0xeY",authDomain:"t-cube-social.firebaseapp.com",projectId:"t-cube-social",storageBucket:"t-cube-social.firebasestorage.app",messagingSenderId:"66553755113",appId:"1:66553755113:web:dc6dac53eb854de2308778"});
const auth=getAuth(app),db=getFirestore(app);
const $=i=>document.getElementById(i),f=$('f'),W=window;
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const ago=t=>{const s=(Date.now()-t)/1000;return s<60?'рдЕрднреА':s<3600?Math.floor(s/60)+' рдорд┐рдирдЯ рдкрд╣рд▓реЗ':s<86400?Math.floor(s/3600)+' рдШрдВрдЯреЗ рдкрд╣рд▓реЗ':new Date(t).toLocaleDateString('hi-IN')};
let U=null,profs={},reqs=[],posts=[],cur=0,fl=0,file=null,myPh=null,subs=[],signup=false;
W.sw=()=>{signup=!signup;$('nm').style.display=signup?'block':'none';$('lt').textContent=signup?'рдирдпрд╛ рдЕрдХрд╛рдЙрдВрдЯ':'рд▓реЙрдЧрд┐рди рдХрд░реЗрдВ';$('gb').textContent=signup?'рдЕрдХрд╛рдЙрдВрдЯ рдмрдирд╛рдПрдБ':'рд▓реЙрдЧрд┐рди';$('sb').textContent=signup?'рд▓реЙрдЧрд┐рди рдкрд░ рдЬрд╛рдПрдБ':'рдирдпрд╛ рдЕрдХрд╛рдЙрдВрдЯ рдмрдирд╛рдПрдБ'};
W.go=async()=>{const e=$('em').value.trim(),p=$('pw').value,n=$('nm').value.trim();$('le').textContent='';
 try{if(signup){if(!n){$('le').textContent='рдирд╛рдо рд▓рд┐рдЦреЗрдВ';return}const c=await createUserWithEmailAndPassword(auth,e,p);await setDoc(doc(db,'profiles',c.user.uid),{name:n,photo:'',ts:Date.now()})}else await signInWithEmailAndPassword(auth,e,p)}
 catch(x){$('le').textContent='рддреНрд░реБрдЯрд┐: '+x.code}};
onAuthStateChanged(auth,u=>{subs.forEach(s=>s());subs=[];U=u;$('login').style.display=u?'none':'block';$('app').style.display=u?'block':'none';if(!u)return;
 subs.push(onSnapshot(collection(db,'profiles'),s=>{profs={};s.forEach(d=>profs[d.id]=d.data());redraw()}),
 onSnapshot(collection(db,'reqs'),s=>{reqs=s.docs.map(d=>d.data());redraw()}),
 onSnapshot(query(collection(db,'posts'),orderBy('ts','desc'),limit(50)),s=>{posts=s.docs.map(d=>({id:d.id,...d.data()}));redraw()}))});
const me=()=>(profs[U.uid]||{}).name||'';
const isF=u=>reqs.some(r=>r.st==='ok'&&((r.from===U.uid&&r.to===u)||(r.to===U.uid&&r.from===u)));
const av=(u,c)=>{const p=profs[u]||{};return p.photo?'<img class="av '+(c||'')+'" src="'+p.photo+'">':'<div class="av '+(c||'')+'">'+esc((p.name||'?')[0])+'</div>'};
const nm=(u,n)=>(profs[u]&&profs[u].name)||n||'рдЕрдирдЬрд╛рди';
W.tab=i=>{cur=i;[0,1,2].forEach(j=>$('t'+j).className=j==i?'a':'');redraw()};
W.flt=i=>{fl=i;$('f0').className='g'+(i?'':' on');$('f1').className='g'+(i?' on':'');redraw()};
function redraw(){if(!U)return;$('home').style.display=cur==0?'block':'none';$('fr').style.display=cur==1?'block':'none';$('pf').style.display=cur==2?'block':'none';
 if(cur==0)feed();if(cur==1)friends();if(cur==2&&!document.activeElement.id.startsWith('pn'))profile()}
function feed(){const l=posts.filter(p=>!fl||p.uid===U.uid||isF(p.uid));const open=new Set([...document.querySelectorAll('.cm.open')].map(e=>e.dataset.id));
 $('feed').innerHTML=l.length?l.map(p=>{const lk=p.likes||[],cs=p.comments||[],o=open.has(p.id);return '<div class="card"><div class="h">'+av(p.uid)+'<div class="sp"><div class="n">'+esc(nm(p.uid,p.name))+'</div><div class="t">'+ago(p.ts)+'</div></div>'+(p.uid===U.uid?'<button class="g" onclick="del(\''+p.id+'\')">ЁЯЧС</button>':'')+'</div>'
 +(p.text?'<div class="p">'+esc(p.text)+'</div>':'')+(p.img?'<img class="m" src="'+p.img+'">':'')+'<div class="t" style="margin-top:6px">ЁЯСН '+lk.length+' ┬╖ ЁЯТм '+cs.length+'</div>'
 +'<div class="bar"><button class="g '+(lk.includes(U.uid)?'on':'')+'" onclick="like(\''+p.id+'\','+lk.includes(U.uid)+')">ЁЯСН рд▓рд╛рдЗрдХ</button><button class="g" onclick="tg(\''+p.id+'\')">ЁЯТм рдХрдореЗрдВрдЯ</button></div>'
 +'<div class="cm'+(o?' open':'')+'" data-id="'+p.id+'" style="display:'+(o?'block':'none')+'">'+cs.map(c=>'<div class="c"><b>'+esc(nm(c.uid,c.name))+'</b> '+esc(c.text)+'</div>').join('')
 +'<div class="row"><input type="text" id="ci'+p.id+'" placeholder="рдХрдореЗрдВрдЯ рд▓рд┐рдЦреЗрдВ..." style="margin:0"><button onclick="cmt(\''+p.id+'\')">рднреЗрдЬреЗрдВ</button></div></div></div>'}).join(''):'<div class="card t">рдЕрднреА рдХреЛрдИ рдкреЛрд╕реНрдЯ рдирд╣реАрдВ рд╣реИред</div>'}
W.tg=id=>{const e=document.querySelector('.cm[data-id="'+id+'"]');e.classList.toggle('open');e.style.display=e.classList.contains('open')?'block':'none'};
W.like=(id,l)=>updateDoc(doc(db,'posts',id),{likes:l?arrayRemove(U.uid):arrayUnion(U.uid)});
W.cmt=id=>{const i=$('ci'+id),t=i.value.trim();if(!t)return;i.value='';updateDoc(doc(db,'posts',id),{comments:arrayUnion({uid:U.uid,name:me(),text:t,ts:Date.now()})})};
W.del=id=>{if(confirm('рдпрд╣ рдкреЛрд╕реНрдЯ рд╣рдЯрд╛рдПрдБ?'))deleteDoc(doc(db,'posts',id))};
function shrink(fl,max,lim){return new Promise((ok,no)=>{const im=new Image();im.onload=()=>{let r=Math.min(1,max/Math.max(im.width,im.height)),w=im.width*r,h=im.height*r,q=.8,d;const c=document.createElement('canvas');
 for(let i=0;i<6;i++){c.width=w;c.height=h;c.getContext('2d').drawImage(im,0,0,w,h);d=c.toDataURL('image/jpeg',q);if(d.length<lim)break;q-=.1;w*=.8;h*=.8}ok(d)};im.onerror=no;im.src=URL.createObjectURL(fl)})}
f.onchange=()=>{file=f.files[0];if(file)$('pvw').innerHTML='<img class="pv" src="'+URL.createObjectURL(file)+'">'};
W.post=async()=>{const text=$('tx').value.trim();if(!text&&!file)return;$('pb').disabled=true;$('msg').textContent='рднреЗрдЬ рд░рд╣реЗ рд╣реИрдВ...';
 try{const d={uid:U.uid,name:me(),text,ts:Date.now(),likes:[],comments:[]};if(file)d.img=await shrink(file,900,170000);await addDoc(collection(db,'posts'),d);$('tx').value='';$('pvw').innerHTML='';file=null;f.value='';$('msg').textContent=''}
 catch(e){$('msg').textContent='рдкреЛрд╕реНрдЯ рдирд╣реАрдВ рд╣реБрдЖ: '+e.code}$('pb').disabled=false};
W.sendReq=to=>setDoc(doc(db,'reqs',U.uid+'__'+to),{from:U.uid,to,st:'pending',ts:Date.now()});
W.acc=from=>updateDoc(doc(db,'reqs',from+'__'+U.uid),{st:'ok'});
W.unf=async u=>{for(const id of [U.uid+'__'+u,u+'__'+U.uid])try{await deleteDoc(doc(db,'reqs',id))}catch(e){}};
function friends(){const k=U.uid,inc=reqs.filter(r=>r.to===k&&r.st==='pending'),fr=Object.keys(profs).filter(u=>u!==k&&isF(u)),oth=Object.keys(profs).filter(u=>u!==k&&!isF(u));
 const row=(u,b)=>'<div class="card h">'+av(u)+'<div class="n sp">'+esc(nm(u))+'</div>'+b+'</div>';
 const st=u=>reqs.some(r=>r.from===k&&r.to===u&&r.st==='pending')?'<span class="t">рд░рд┐рдХреНрд╡реЗрд╕реНрдЯ рднреЗрдЬреА</span>':reqs.some(r=>r.from===u&&r.to===k&&r.st==='pending')?'<button onclick="acc(\''+u+'\')">рд╕реНрд╡реАрдХрд╛рд░реЗрдВ</button>':'<button onclick="sendReq(\''+u+'\')">тЮХ рджреЛрд╕реНрдд рдмрдирд╛рдПрдБ</button>';
 $('fr').innerHTML='<b>рдлреНрд░реЗрдВрдб рд░рд┐рдХреНрд╡реЗрд╕реНрдЯ ('+inc.length+')</b>'+inc.map(r=>row(r.from,'<button onclick="acc(\''+r.from+'\')">рд╕реНрд╡реАрдХрд╛рд░реЗрдВ</button>')).join('')+'<br><b>рдореЗрд░реЗ рджреЛрд╕реНрдд ('+fr.length+')</b>'+fr.map(u=>row(u,'<button class="g" onclick="unf(\''+u+'\')">рд╣рдЯрд╛рдПрдБ</button>')).join('')
 +'<br><b>рдФрд░ рд▓реЛрдЧ</b>'+(oth.length?oth.map(u=>row(u,st(u))).join(''):'<div class="card t">рдЕрднреА рдХреЛрдИ рдФрд░ рдирд╣реАрдВ рд╣реИред рдРрдк рдХрд╛ рд▓рд┐рдВрдХ рджреЛрд╕реНрддреЛрдВ рдХреЛ рднреЗрдЬреЗрдВ!</div>')}
function profile(){const p=profs[U.uid]||{},ph=myPh||p.photo;
 $('pf').innerHTML='<div class="card" style="text-align:center">'+(ph?'<img class="av big" src="'+ph+'">':'<div class="av big">'+esc((p.name||'?')[0])+'</div>')+'<div class="row" style="justify-content:center"><button class="g" onclick="pfile.click()">ЁЯУ╖ рдлреЛрдЯреЛ рдмрджрд▓реЗрдВ</button></div><input type="file" id="pfile" accept="image/*" hidden onchange="pickPh(this)">'
 +'<input type="text" id="pname" value="'+esc(p.name||'')+'" placeholder="рдЖрдкрдХрд╛ рдирд╛рдо"><div class="row" style="justify-content:center"><button onclick="saveProf()">рд╕реЗрд╡ рдХрд░реЗрдВ</button><button class="g" onclick="logout()">рд▓реЙрдЧрдЖрдЙрдЯ</button></div><div class="t" id="pmsg"></div></div>'}
W.pickPh=async i=>{const fl=i.files[0];if(!fl)return;myPh=await shrink(fl,200,30000);profile()};
W.saveProf=async()=>{const n=$('pname').value.trim();if(!n)return;try{await setDoc(doc(db,'profiles',U.uid),{name:n,photo:myPh||(profs[U.uid]||{}).photo||'',ts:Date.now()});myPh=null;$('pmsg').textContent='рд╕реЗрд╡ рд╣реЛ рдЧрдпрд╛ тЬУ'}catch(e){$('pmsg').textContent='рддреНрд░реБрдЯрд┐: '+e.code}};
W.logout=()=>signOut(auth);
</script></body></html>
